DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nevo
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nevo_test
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-characters
AUTH_PIN_PEPPER=replace-with-a-different-32-character-secret
AUTH_SESSION_PEPPER=replace-with-another-32-character-secret
CONSENT_PUBLIC_BASE_URL=http://localhost:3000
AI_PROVIDER=claude
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-haiku-4-5
AI_ANTHROPIC_SONNET_MODEL=claude-sonnet
AI_PROMPT_CACHING_ENABLED=true
AI_REQUESTS_PER_MINUTE=60
AI_MAX_CONCURRENCY=4
AI_INPUT_COST_USD_PER_MILLION=1
AI_OUTPUT_COST_USD_PER_MILLION=5
AI_CACHE_WRITE_COST_USD_PER_MILLION=1.25
AI_CACHE_READ_COST_USD_PER_MILLION=0.10
# Public URL to self-ping to keep the host from idling. Render sets
# RENDER_EXTERNAL_URL automatically in deployed environments; only set this
# to override it (e.g. locally, it is left unset and self-pinging no-ops).
OPS_SELF_PING_URL=
OPS_SELF_PING_INTERVAL_SECONDS=600
OPS_HEARTBEAT_CHECK_INTERVAL_SECONDS=3600
